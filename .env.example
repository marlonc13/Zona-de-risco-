# Copie este arquivo para .env e preencha com os seus tokens do Mapbox.
# Nunca publique o arquivo .env.

# Token público (começa com pk.), usado pelo app para exibir o mapa
EXPO_PUBLIC_MAPBOX_TOKEN=

# Token secreto (começa com sk.) com o escopo DOWNLOADS:READ,
# usado somente durante o build para baixar o SDK nativo do Mapbox
MAPBOX_SECRET_TOKEN=
